# Copy to tests/live/.env (gitignored) or export these before `make test-live`.
MT5_LIVE_URL=http://127.0.0.1:8888
MT5_LIVE_TOKEN=your-bearer-token-here
MT5_LIVE_BROKER=yourbroker
MT5_LIVE_ACCOUNT=youraccount
MT5_LIVE_INSTANCE=default
MT5_LIVE_SYMBOL=EURUSD
MT5_LIVE_TIMEFRAME=M15
# "1" runs the state-changing tests on a non-demo account.
MT5_LIVE_ALLOW_REAL=0
# "1" also tests changing the WebRequest allowlist (drives the terminal GUI).
MT5_LIVE_WEBREQUEST=0
